{
  "expo": {
    "name": "Libertà in Conoscenza",
    "slug": "conoscenza-aperta",
    "version": "1.0.0",
    "description": "Piattaforma di formazione digitale sul ben-essere olistico: meditazioni guidate, corsi online, biblioteca di articoli su biofisica quantistica, medicina integrata, discipline naturali e crescita personale.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "conoscenzaaperta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.integralwellness.pc8j5c",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Scegli una foto per gli articoli",
        "NSPhotoLibraryAddUsageDescription": "Salva immagini nella galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.integralwellness.pc8j5c",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Libertà in Conoscenza",
      "shortName": "Libertà",
      "description": "Piattaforma di formazione digitale sul ben-essere olistico: meditazioni, corsi, biblioteca.",
      "themeColor": "#D4AF37",
      "backgroundColor": "#0A0F0D",
      "display": "standalone",
      "lang": "it",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-notifications",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Scegli una foto per gli articoli"
        }
      ],
      "@react-native-vector-icons/fontawesome6"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
